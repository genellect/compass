NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CONTACT_TURNSTILE_SITE_KEY=

# Future Strategy Library registration frontend.
# Keep mock mode for ordinary builds until the production API and OAuth gates pass.
NEXT_PUBLIC_LIBRARY_REGISTRATION_MODE=mock
NEXT_PUBLIC_LIBRARY_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_LIBRARY_GOOGLE_HOSTED_DOMAIN=st.kitasato-u.ac.jp

# Phase 8B administrator UI. Use mock for static/local review and google only
# after the production OAuth/API gates pass. Production uses the exact same-origin
# proxy path below and a separate admin Web OAuth client. Never add a secret or token.
NEXT_PUBLIC_LIBRARY_ADMIN_MODE=mock
NEXT_PUBLIC_LIBRARY_ADMIN_API_BASE_URL=
NEXT_PUBLIC_LIBRARY_ADMIN_GOOGLE_OAUTH_CLIENT_ID=
