# Local composite example only. Do not put real credentials in this file.
# Production public/admin/worker/migration services use distinct Secret Manager
# bindings defined under infra/library-registration/terraform.
APP_ENV=development
SERVICE_SURFACE=local-composite
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# Migration/recovery only. Do not provide this variable to public, admin, or worker.
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Production public/admin/worker only: exact LOGIN role encoded in DATABASE_URL.
# Owner/admin/superuser-style names are rejected.
RUNTIME_DATABASE_ROLE=
# Production public must use the bounded database RPC contract. Local and
# SQLite development retain the ORM default.
PUBLIC_DATABASE_ACCESS_MODE=orm
# Independent production-only bearer capability. Store only in Secret Manager
# and the local environment; the database stores SHA-256 only.
PUBLIC_REGISTRATION_RPC_KEY_VERSION=v1
PUBLIC_REGISTRATION_RPC_TOKEN=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=240
DB_STATEMENT_TIMEOUT_SECONDS=10
PII_LOGGING_ENABLED=false
STRUCTURED_LOGGING_ENABLED=true
API_READ_ONLY_MODE=false
# Production write restoration only. Terraform supplies the reviewed value;
# keep empty whenever API_READ_ONLY_MODE=true.
API_WRITES_ACTIVATION_CONFIRMATION=
TERMS_VERSION=phase3-draft-2026-07-16
PRIVACY_VERSION=phase3-draft-2026-07-16
# Required only for production public startup after human approval.
TERMS_CONTENT_SHA256=
PRIVACY_CONTENT_SHA256=
EXTERNAL_SIDE_EFFECTS_ENABLED=false
PHASE5_LOCAL_API_ENABLED=true
PHASE6_AUTH_API_ENABLED=false
# Public OAuth client IDs only. Never place a client secret or ID token here.
GOOGLE_OAUTH_CLIENT_IDS=
# Admin OAuth client IDs must be separate from public registration client IDs.
GOOGLE_ADMIN_OAUTH_CLIENT_IDS=
# Exact normalized administrator emails. Production receives this value from
# Secret Manager; never commit real addresses to this example or source tree.
GOOGLE_ADMIN_ALLOWED_EMAILS=
# Shared only by the Pages admin proxy and production admin API. Generate a
# random 32-512 character value and store it in each platform's secret store.
LIBRARY_ADMIN_EDGE_SHARED_SECRET=
ALLOWED_GOOGLE_HOSTED_DOMAINS=st.kitasato-u.ac.jp
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
GOOGLE_ID_TOKEN_MAX_CHARS=8192
MAX_REQUEST_BODY_BYTES=16384
PREAUTH_RATE_LIMIT_PER_MINUTE=300
ADMIN_PREAUTH_RATE_LIMIT_PER_MINUTE=30
SUBMIT_RATE_LIMIT_PER_HOUR=5
SUBMIT_GLOBAL_RATE_LIMIT_PER_MINUTE=30
STATUS_RATE_LIMIT_PER_FIVE_MINUTES=30
RATE_LIMITS_ENABLED=false
# Worker-only actual target. Keep empty on public/admin services.
DRIVE_RESOURCE_ID=
# Shared only by authorized operation producers (public/admin) and worker.
# Generate at least 32 random bytes; never reuse an edge, DB, or OAuth secret.
DRIVE_OPERATION_ATTESTATION_KEY=local-synthetic-drive-operation-attestation-key-v1
DRIVE_OPERATION_ATTESTATION_TTL_SECONDS=3600
PHASE7_WORKER_API_ENABLED=false
PHASE7_DRIVE_API_ENABLED=false
PHASE7_DRIVE_KILL_SWITCH=true
# Production activation only. Keep empty while safely stopped.
PHASE7_DRIVE_ACTIVATION_CONFIRMATION=
# At least 32 random characters. Store in Secret Manager for production.
PHASE7_WORKER_SECRET=
# Production uses Cloud Run IAM + Scheduler OIDC and does not use a custom
# secret header. These public identity values are exact, not wildcard values.
WORKER_AUTH_MODE=shared_secret
WORKER_OIDC_AUDIENCE=
WORKER_INVOKER_SERVICE_ACCOUNT=
PHASE8_ADMIN_API_ENABLED=false
# Production activation only after bootstrap, MFA, and host review.
PHASE8_ADMIN_ACTIVATION_CONFIRMATION=
# Administrative decisions/retries/revocations/deactivations remain separately
# hidden behind a write kill switch. Read-only admin routes remain available.
ADMIN_MUTATIONS_ENABLED=false
ADMIN_MUTATIONS_ACTIVATION_CONFIRMATION=
# Phase 10A roster download is a separate, fail-closed admin capability.
PHASE10A_EXPORT_API_ENABLED=false
# Production activation only after data-handling, auth, and DB role review.
PHASE10A_EXPORT_ACTIVATION_CONFIRMATION=
PHASE10A_EXPORT_MAX_ROWS=5000
PHASE10A_EXPORT_MAX_BYTES=10485760
PHASE10A_EXPORT_RATE_LIMIT_PER_HOUR=12
PHASE10A_DOWNLOAD_RETENTION_DAYS=30
PHASE7_OPERATION_LEASE_SECONDS=60
PHASE7_RESOURCE_LEASE_SECONDS=60
PHASE7_RETRY_BASE_SECONDS=30
WORKER_BATCH_SIZE=20
WORKER_TIME_BUDGET_SECONDS=45
DRIVE_REQUEST_TIMEOUT_SECONDS=20
# Owner OAuth credentials. Never commit real values or expose them to NEXT_PUBLIC.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
